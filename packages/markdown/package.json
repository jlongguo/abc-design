{
  "name": "@abc-design/markdown",
  "version": "0.1.0",
  "description": "ABC Design Markdown — 自动联动明暗主题、支持光标精准插值与三态预览的企业级 Markdown 编辑器子包",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@uiw/react-md-editor": "^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@abc-design/react": "workspace:*",
    "@abc-design/tokens": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  }
